# Production on Render (single service — app + API + WebSocket + FOMO runner)
# Render sets RENDER_EXTERNAL_URL automatically; APP_URL is optional override.
# APP_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: only needed when frontend and API are on different hosts
# VITE_TRACKER_URL=

# Optional: only needed when FOMO runner is on a different host than the app
# VITE_NETLIFY_URL=
