{
  "name": "x",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "cp fomo/public/r.html public/r.html",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev:server\" \"vite\"",
    "dev:all": "concurrently -n server,web,fomo -c cyan,magenta,yellow \"npm run dev:server\" \"vite\" \"npm run dev:fomo\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:fomo": "cd fomo && npx netlify dev --offline",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "build:netlify": "npm run prebuild && vite build",
    "build:render": "npm run prebuild && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start:server": "tsx server/index.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@heroicons-animated/react": "^1.3.0",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
